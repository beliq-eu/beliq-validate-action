    "check": "node --check runner.mjs",
    "scrub:check": "bash scripts/scrub-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vitest": "^4.0.0"
  }
