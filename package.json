{
  "name": "beliq-validate-action",
  "version": "1.3.0",
  "private": true,
  "description": "GitHub Action that validates e-invoices in CI with beliq and shows how deep each check went.",
  "type": "module",
  "license": "MIT",
  "author": "beliq <hello@beliq.eu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beliq-eu/beliq-validate-action.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint runner.mjs test",
